<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.2"
             xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
    <persistence-unit name="U4W4BW1">
        <!-- Il persistence unit ci serve per configurare la connessione ad uno specifico db -->
        <class>noemibaglieri.entities.User</class>
        <class>noemibaglieri.entities.Bus</class>
        <class>noemibaglieri.entities.Card</class>
        <class>noemibaglieri.entities.HumanVendor</class>
        <class>noemibaglieri.entities.MachineVendor</class>
        <class>noemibaglieri.entities.Maintenance</class>
        <class>noemibaglieri.entities.Pass</class>
        <class>noemibaglieri.entities.Route</class>
        <class>noemibaglieri.entities.Ticket</class>
        <class>noemibaglieri.entities.Tram</class>
        <class>noemibaglieri.entities.Vehicle</class>
        <class>noemibaglieri.entities.VehicleTrip</class>
        <class>noemibaglieri.entities.Vendor</class>
        <class>noemibaglieri.entities.Service</class>
        <!-- Serve specificare l'elenco delle entities con tanto di package -->
        <properties>
            <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/U4W4BW1"/>
            <!-- Dopo l'ultimo slash inserisco il nome del database al quale voglio collegarmi (IL DB DEVE ESISTERE PERO') -->
            <property name="javax.persistence.jdbc.user" value="postgres"/>
            <property name="javax.persistence.jdbc.password" value="1234"/>
            <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!-- Quest'ultima impostazione serve per chiedere a Hibernate di crearci le tabelle se non esistono ancora
            oppure se esistono aggiornarle se necessario -->
        </properties>
    </persistence-unit>
</persistence>